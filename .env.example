# Copy to .env and fill in the required values.

# ---------- required ----------

# Password for the web UI.
ADMIN_PASSWORD=change-me

# 16+ random characters, e.g. `openssl rand -hex 32`.
# Encrypts stored IMAP passwords and OAuth tokens. If it changes, accounts must be reconnected.
APP_SECRET=

# TypeSafe API key for Jev (https://docs.typesafe.ai).
JEV_API_KEY=

# ---------- optional ----------

# Where the UI is reachable from your browser. Used for OAuth redirect URIs.
PUBLIC_URL=http://localhost:8080
# Host port the UI is published on (compose only).
PORT=8080
# Mark the session cookie Secure. Defaults to true when PUBLIC_URL is https.
# COOKIE_SECURE=true

JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai

# Initial values for the Settings page (only used on first start).
DEFAULT_THRESHOLD=0.7
BODY_CHARS=2000
DRY_RUN=true

# Gmail: OAuth client of type "Web application" in Google Cloud.
# Redirect URI: ${PUBLIC_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365: app registration in Microsoft Entra.
# Redirect URI (Web): ${PUBLIC_URL}/api/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# common (work + personal), consumers, organizations, or a tenant id.
MS_TENANT=common

RUST_LOG=info,jev_labeller=info
